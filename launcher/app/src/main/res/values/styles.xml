<resources>
    <style name="Theme.AdLessTV" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#D8E3F2</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#090B10</item>
        <item name="android:navigationBarColor">#090B10</item>
        <item name="android:statusBarColor">#090B10</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="ActionPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#F4F5F8</item>
        <item name="android:maxLines">1</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/focus_action</item>
    </style>
</resources>
