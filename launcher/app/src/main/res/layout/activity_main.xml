<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="48dp" android:paddingEnd="48dp"
    android:paddingTop="27dp" android:paddingBottom="27dp">
    <RelativeLayout android:id="@+id/top_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp">
        <LinearLayout android:id="@+id/actions" android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <ImageButton android:id="@+id/action_inputs" style="@style/ActionPill"
                android:src="@drawable/ic_inputs" android:contentDescription="@string/inputs" />
            <ImageButton android:id="@+id/action_network" style="@style/ActionPill"
                android:src="@drawable/ic_network" android:contentDescription="@string/network" />
            <ImageButton android:id="@+id/action_settings" style="@style/ActionPill"
                android:src="@drawable/ic_settings" android:contentDescription="@string/settings" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true"
            android:layout_toStartOf="@id/actions" android:layout_marginEnd="16dp" android:layout_alignParentStart="true"
            android:gravity="center_vertical"
            android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:background="@drawable/toolbar_surface">
            <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:maxLines="1"
                android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F4F5F8"
                android:textSize="30sp" android:fontFamily="sans-serif-light" />
            <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="EEE, MMM d" android:format24Hour="EEE, MMM d"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                android:textColor="#A2A9B6" android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout android:id="@+id/hero" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="88dp" android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp" android:orientation="vertical"
        android:gravity="center_vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
        android:background="@drawable/hero_surface">
        <TextView android:id="@+id/hero_name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:text="@string/app_name" android:textSize="27sp"
            android:textStyle="bold" android:textColor="#F6F7FA" />
        <TextView android:id="@+id/hero_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/long_press_hint" android:textSize="13sp" android:textColor="#B4BEC9"
            android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/hero_open" style="@style/HeroButton"
                android:text="@string/open_app" />
            <Button android:id="@+id/hero_info" style="@style/HeroButton"
                android:layout_marginStart="10dp" android:text="@string/app_details" />
        </LinearLayout>
    </LinearLayout>
    <View android:id="@+id/idle_spacer"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:importantForAccessibility="no" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/dock"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:layout_marginBottom="12dp"
        android:padding="10dp" android:background="@drawable/dock_surface"
        android:clipToPadding="false" android:clipChildren="false"
        android:scrollbars="none" android:overScrollMode="never"
        android:descendantFocusability="afterDescendants" />
    <FrameLayout android:id="@+id/catalog_container" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:visibility="gone">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent"
            android:layout_height="match_parent" android:clipToPadding="false" android:clipChildren="false"
            android:padding="6dp" android:scrollbars="none" android:overScrollMode="never"
            android:descendantFocusability="afterDescendants" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:text="@string/loading_apps" android:textColor="#A2A9B6"
            android:textSize="18sp" android:padding="16dp" />
    </FrameLayout>
</LinearLayout>
