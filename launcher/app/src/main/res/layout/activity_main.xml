<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="48dp" android:paddingEnd="48dp"
    android:paddingTop="27dp" android:paddingBottom="27dp">
    <RelativeLayout android:id="@+id/top_bar" android:layout_width="match_parent" android:layout_height="44dp">
        <LinearLayout android:id="@+id/actions" android:layout_alignParentEnd="true"
            android:layout_centerVertical="true" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <ImageButton android:id="@+id/action_inputs" style="@style/ActionPill"
                android:src="@drawable/ic_inputs" android:contentDescription="@string/inputs" />
            <ImageButton android:id="@+id/action_network" style="@style/ActionPill"
                android:src="@drawable/ic_network" android:contentDescription="@string/network" />
            <ImageButton android:id="@+id/action_settings" style="@style/ActionPill"
                android:src="@drawable/ic_settings" android:contentDescription="@string/settings" />
        </LinearLayout>
        <LinearLayout android:id="@+id/clock_pill" android:layout_width="wrap_content" android:layout_height="44dp"
            android:layout_alignParentStart="true" android:layout_centerVertical="true"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/toolbar_surface">
            <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:maxLines="1"
                android:includeFontPadding="false" android:textColor="#F4F5F8"
                android:textSize="26sp" android:fontFamily="sans-serif-medium" />
            <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:format12Hour="EEE, MMM d" android:format24Hour="EEE, MMM d"
                android:includeFontPadding="false" android:maxLines="1"
                android:textColor="#A2A9B6" android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>
    <FrameLayout android:id="@+id/hero" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp">
        <TextView android:id="@+id/hero_mark" android:layout_width="260dp" android:layout_height="match_parent"
            android:layout_gravity="end" android:gravity="center" android:textSize="190sp"
            android:textStyle="bold" android:textColor="#FFFFFF" android:alpha="0.045"
            android:includeFontPadding="false" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center_vertical">
            <TextView android:id="@+id/hero_kicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/your_home" android:textSize="16sp" android:textColor="#ADB3BD"
                android:includeFontPadding="false" android:layout_marginBottom="10dp" />
            <TextView android:id="@+id/hero_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
                android:text="@string/app_name" android:textSize="64sp" android:fontFamily="sans-serif-black"
                android:textColor="#F6F7FA" />
            <TextView android:id="@+id/hero_hint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/installed_app" android:textSize="19sp" android:textColor="#AAB0BC"
                android:maxLines="1" android:layout_marginTop="10dp" android:includeFontPadding="false" />
            <LinearLayout android:id="@+id/hero_buttons" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="18dp">
                <Button android:id="@+id/hero_open" style="@style/HeroButton"
                    android:background="@drawable/primary_action" android:textColor="#101217" android:text="@string/open_app" />
                <Button android:id="@+id/hero_info" style="@style/HeroButton"
                    android:layout_marginStart="12dp" android:text="@string/app_details_short" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    <TextView android:id="@+id/shelf_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/favorites" android:textColor="#A2A9B6" android:textSize="15sp"
        android:includeFontPadding="false" android:layout_marginBottom="4dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/dock"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="6dp" android:clipToPadding="false" android:clipChildren="false"
        android:scrollbars="none" android:overScrollMode="never" android:descendantFocusability="afterDescendants" />
    <FrameLayout android:id="@+id/library" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:visibility="gone">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent"
            android:layout_height="match_parent" android:clipToPadding="false" android:clipChildren="false"
            android:padding="6dp" android:scrollbars="none" android:overScrollMode="never"
            android:descendantFocusability="afterDescendants" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:text="@string/loading_apps" android:textColor="#A2A9B6"
            android:textSize="18sp" android:padding="16dp" />
    </FrameLayout>
    <TextView android:id="@+id/library_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="@string/library_hint" android:textSize="13sp"
        android:maxLines="1" android:ellipsize="end" android:textColor="#8F96A3" android:includeFontPadding="false" />
</LinearLayout>
