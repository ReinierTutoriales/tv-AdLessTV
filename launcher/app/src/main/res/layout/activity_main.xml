<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:clipChildren="false" android:clipToPadding="false"
    android:orientation="vertical" android:paddingStart="48dp" android:paddingEnd="48dp"
    android:paddingTop="27dp" android:paddingBottom="27dp">
    <LinearLayout android:id="@+id/top_bar" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:id="@+id/clock_pill" android:layout_width="0dp" android:layout_height="56dp"
            android:layout_weight="1"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="4dp" android:paddingEnd="4dp">
            <TextClock android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:maxLines="1"
                android:includeFontPadding="false" android:textColor="#F4F5F8"
                android:textSize="42sp" android:fontFamily="sans-serif-light" />
            <TextClock android:id="@+id/date" android:layout_width="wrap_content" android:maxWidth="160dp" android:layout_height="wrap_content"
                android:layout_marginStart="14dp" android:format12Hour="EEE, MMM d" android:format24Hour="EEE, MMM d"
                android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
                android:textColor="#A2A9B6" android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/actions" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/action_inputs" style="@style/ActionPill"
                android:drawableStart="@drawable/ic_inputs" android:text="@string/inputs" />
            <TextView android:id="@+id/action_network" style="@style/ActionPill"
                android:drawableStart="@drawable/ic_network" android:text="@string/network" />
            <TextView android:id="@+id/action_settings" style="@style/ActionPill"
                android:drawableStart="@drawable/ic_settings" android:text="@string/settings" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/hero" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp">
        <TextView android:id="@+id/hero_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom|start" android:maxLines="1" android:ellipsize="end"
            android:includeFontPadding="false" android:text="@string/app_name"
            android:textSize="56sp" android:fontFamily="sans-serif-light" android:textColor="#F6F7FA" />
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/dock"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:padding="12dp" android:clipToPadding="false" android:clipChildren="false"
        android:scrollbars="none" android:overScrollMode="never" android:descendantFocusability="afterDescendants" />
    <FrameLayout android:id="@+id/library" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:visibility="gone">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid" android:layout_width="match_parent"
            android:layout_height="match_parent" android:clipToPadding="false" android:clipChildren="false"
            android:padding="6dp" android:scrollbars="none" android:overScrollMode="never"
            android:descendantFocusability="afterDescendants" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:text="@string/loading_apps" android:textColor="#A2A9B6"
            android:textSize="18sp" android:padding="16dp" />
    </FrameLayout>
    <TextView android:id="@+id/library_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:layout_marginTop="12dp" android:text="@string/library_hint" android:textSize="13sp"
        android:maxLines="1" android:ellipsize="end" android:textColor="#8F96A3" android:includeFontPadding="false" />
</LinearLayout>
